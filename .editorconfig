root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,yml,yaml}]
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 2

[*.{ts,tsx,js,jsx,css,html}]
indent_style = space
indent_size = 2

[*.cs]
indent_style = space
indent_size = 4
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_var_when_type_is_apparent = suggestion
dotnet_style_object_initializer = suggestion

[*.{csproj,props,targets}]
indent_style = space
indent_size = 2
