#!/usr/bin/env bash
# LTL 本地开发一键启动（借鉴 Rails foreman 的使用体验，纯 bash 实现，零第三方依赖）。
#
#   bin/dev                  启动 Procfile.dev 中的全部进程
#   WEB_PORT=5174 bin/dev    覆盖前端端口（默认 5173）
#   Ctrl+C / SIGTERM         一次性停止全部进程及其子进程
#
# 只管理 api / web 两个应用进程；数据库与 Redis 需提前自行启动：
#   cp .env.example .env && docker compose up -d
#
# 停止时按「进程树」逐个发信号，而不是只杀 dotnet run / npm 这两层壳，
# 否则它们拉起的 Ltl.Api、vite 子进程会变成孤儿继续占用端口。

set -uo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR" || exit 1

PROCFILE="${PROCFILE:-$ROOT_DIR/Procfile.dev}"
WEB_PORT="${WEB_PORT:-5173}"
API_PORT=5080
export WEB_PORT

COLORS=(36 35 33 32 34) # 各进程日志前缀轮换的 ANSI 色号
PIDS=()
NAMES=()
TREE=()
PROBE_PID=""
STOPPED=0

info() { printf '\033[1;34m[dev]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[dev]\033[0m %s\n' "$*" >&2; }
die() {
  printf '\033[1;31m[dev]\033[0m %s\n' "$*" >&2
  exit 1
}

# 给聚合后的每一行日志加上「[进程名]」前缀；仅当输出到终端时着色。
prefix_lines() {
  local name="$1" color="$2" line color_on='' color_off=''
  if [[ -t 1 ]]; then
    color_on="\033[${color}m"
    color_off='\033[0m'
  fi
  while IFS= read -r line || [[ -n "$line" ]]; do
    printf '%b[%-5s]%b %s\n' "$color_on" "$name" "$color_off" "$line"
  done
}

# 每个进程独占一个后台作业；exec 保证记录到的 PID 就是进程树的根。
start_proc() {
  local name="$1" color="$2" cmd="$3" pid
  (exec bash -c "$cmd") > >(prefix_lines "$name" "$color") 2>&1 &
  pid=$!
  PIDS+=("$pid")
  NAMES+=("$name")
  info "已启动 ${name}（PID ${pid}）"
}

# 先序输出 pid 及其全部后代。必须在发任何信号之前收集完整，
# 否则父进程退出后子进程会被 init 接管，pgrep -P 就查不到了。
collect_tree() {
  local pid="$1" child
  printf '%s\n' "$pid"
  for child in $(pgrep -P "$pid" 2>/dev/null || true); do
    collect_tree "$child"
  done
}

cleanup() {
  if [[ "$STOPPED" -eq 1 ]]; then return; fi
  STOPPED=1
  trap - INT TERM EXIT
  # 启动前检查失败时并未拉起任何进程，静默退出即可。
  if [[ ${#PIDS[@]} -eq 0 ]]; then return; fi
  info '正在停止全部进程…'

  TREE=()
  local pid p i alive
  while IFS= read -r p; do
    [[ -n "$p" ]] && TREE+=("$p")
  done < <(
    for pid in "${PIDS[@]}"; do collect_tree "$pid"; done
    if [[ -n "$PROBE_PID" ]]; then collect_tree "$PROBE_PID"; fi
  )

  for pid in "${TREE[@]}"; do kill -TERM "$pid" 2>/dev/null || true; done

  # 最多等待 8 秒优雅退出，超时再强制终止。
  alive=1
  for ((i = 0; i < 16; i++)); do
    alive=0
    for pid in "${TREE[@]}"; do
      if kill -0 "$pid" 2>/dev/null; then alive=1; fi
    done
    if [[ "$alive" -eq 0 ]]; then break; fi
    sleep 0.5
  done
  if [[ "$alive" -eq 1 ]]; then
    for pid in "${TREE[@]}"; do kill -KILL "$pid" 2>/dev/null || true; done
  fi
  wait 2>/dev/null || true
  info '已停止'
}

trap 'cleanup; exit 130' INT TERM
trap cleanup EXIT

# ── 启动前检查 ───────────────────────────────────────────────
[[ -r "$PROCFILE" ]] || die "找不到进程清单：$PROCFILE"
for tool in dotnet npm curl lsof pgrep; do
  command -v "$tool" >/dev/null 2>&1 || die "缺少命令 ${tool}，请检查本地开发环境"
done

# 端口占用提前报错，避免 Vite --strictPort / Kestrel 启动到一半才失败。
check_port() {
  local port="$1" label="$2" holders
  holders="$(lsof -nP -iTCP:"$port" -sTCP:LISTEN -t 2>/dev/null || true)"
  if [[ -n "$holders" ]]; then
    warn "$label 端口 $port 已被占用："
    lsof -nP -iTCP:"$port" -sTCP:LISTEN 2>/dev/null | sed -n '1,6p' >&2 || true
    die "请先释放端口 ${port}，或改用 WEB_PORT=其他端口 bin/dev"
  fi
}
check_port "$API_PORT" '后端 API'
check_port "$WEB_PORT" '前端 Vite'

# 只做非阻塞提示，不代用户启动 Docker（本脚本只管 api + web）。
if command -v nc >/dev/null 2>&1 && ! nc -z 127.0.0.1 5433 2>/dev/null; then
  warn '本机 5433 未连通，数据库可能未启动：docker compose up -d'
fi

# ── 解析 Procfile.dev 并逐个启动 ──────────────────────────────
index=0
while IFS= read -r line || [[ -n "$line" ]]; do
  line="${line#"${line%%[![:space:]]*}"}" # 去前导空白
  if [[ -z "$line" || "$line" == \#* ]]; then continue; fi
  [[ "$line" == *:* ]] || die "Procfile.dev 格式应为「进程名: 命令」：$line"
  name="${line%%:*}"
  cmd="${line#*:}"
  name="${name%"${name##*[![:space:]]}"}" # 去尾部空白
  cmd="${cmd#"${cmd%%[![:space:]]*}"}"   # 去前导空白
  [[ -n "$name" && -n "$cmd" ]] || die "Procfile.dev 存在空名称或空命令：$line"
  start_proc "$name" "${COLORS[$((index % ${#COLORS[@]}))]}" "$cmd"
  index=$((index + 1))
done <"$PROCFILE"
((index > 0)) || die 'Procfile.dev 中没有可启动的进程'

# 后端就绪后打印访问地址，避免用户面对一堆启动日志不知道何时可用。
probe_health() {
  local i
  for ((i = 0; i < 90; i++)); do
    if curl -fsS --max-time 2 "http://127.0.0.1:$API_PORT/health" >/dev/null 2>&1; then
      info "后端就绪 → http://127.0.0.1:$API_PORT/health"
      info "前端地址 → http://localhost:$WEB_PORT/"
      return 0
    fi
    sleep 1
  done
  warn '后端 90 秒内未就绪，请查看上方 [api] 日志'
}
probe_health &
PROBE_PID=$!

info "共启动 $index 个进程，按 Ctrl+C 停止全部"
# 任一进程退出即视为整体结束（foreman 的默认行为）。
wait -n "${PIDS[@]}" 2>/dev/null || true
if [[ "$STOPPED" -eq 0 ]]; then
  warn '检测到进程退出，正在停止其余进程'
  cleanup
fi
